# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies

# tools/commit_gate.py: one-line, per-clone Flutter SDK path. Deliberately
# not committed -- see that file's docstring ("where Flutter is allowed to
# live") for why this is a local declaration rather than a probed/guessed one.
.flutter_root
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- project-specific ---------------------------------------------------------
# Real secrets live here locally; .env.example is the committed template.
.env
.env.*
!.env.example

# Raw ingest snapshots and normalisation candidates are build output.
/build/raw/
/build/normalized/

# Keystores must never be committed.
*.jks
*.keystore
key.properties

# Build caches that grow large and are machine-specific. `android/.gitignore`
# already covers `.gradle` and `local.properties`; this catches the rest.
android/.kotlin/
.cxx/

# Per-machine tool settings, not project configuration.
.claude/settings.local.json

# Golden comparison output. Written on every failing screenshot run and
# rewritten on the next one; committing it makes an unrelated diff look like a
# UI change.
test/screenshots/failures/
