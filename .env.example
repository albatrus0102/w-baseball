# 여자야구 앱 — 환경 변수 예시
#
# 이 파일에는 실제 비밀값이 없습니다. 그대로 커밋해도 안전합니다.
# 실제 값은 다음 두 곳에만 둡니다.
#   * 로컬 개발: 이 파일을 `.env`로 복사 (`.env`는 .gitignore에 있습니다)
#   * CI/자동화: GitHub Secrets
#
# 앱 바이너리에는 어떤 비밀값도 들어가지 않습니다.
# API 키가 필요한 원천은 GitHub Actions에서만 호출되고, 앱은 그 결과로 만들어진
# 정적 JSON만 내려받습니다. 그래서 키가 하나도 없어도 앱은 완전히 동작합니다.

# ─────────────────────────────────────────────────────────────────────────────
# 1. 앱 빌드 시점 설정 (--dart-define)
#
#   flutter run --dart-define=WB_MANIFEST_BASE_URL=https://example.org/data
#
# 하나도 지정하지 않으면 앱은 번들된 seed 데이터로 동작합니다.
# ─────────────────────────────────────────────────────────────────────────────

# 정적 데이터 배포 주소. 비우면 네트워크 동기화를 하지 않고 기본 데이터만 씁니다.
# 예: https://<사용자>.github.io/w-baseball/  (public-data/ 를 그대로 게시)
WB_MANIFEST_BASE_URL=
WB_MANIFEST_VERSION_PATH=version.json

# 미래 공식 API. transport 는 none | rest | graphql.
# 자세한 연결 절차는 docs/connecting-an-official-api.md 를 보세요.
WB_API_TRANSPORT=none
WB_API_BASE_URL=
WB_API_PAGE_SIZE=100

# 기능 플래그. 모두 기본 false 입니다.
# sponsor 는 켜지 않는 한 라우트 자체가 등록되지 않습니다.
WB_FLAG_SPONSOR_COMMERCE=false
WB_FLAG_PLAYER_PROFILES=false
WB_FLAG_PUSH_MESSAGING=false
WB_FLAG_TASK_METRICS=false

# 원천 어댑터. 이용허락을 받기 전에는 켜지 마세요.
# WBAK/KBSA 가 기본 비활성인 이유는 docs/data-sources.md 에 있습니다.
WB_FLAG_ADAPTER_WBAK=false
WB_FLAG_ADAPTER_KBSA=false
WB_FLAG_ADAPTER_WBSC=false
WB_FLAG_ADAPTER_WPBL=false

# Google Forms 진입점. 비우면 해당 항목이 "준비 중"으로 표시되고 눌리지 않습니다.
# 가짜 URL을 넣지 마세요 — 빈 값이 더 정직합니다.
WB_FORM_TEAM_REGISTRATION=
WB_FORM_SCHEDULE_CHANGE=
WB_FORM_RESULT_SUBMISSION=
WB_FORM_DATA_CORRECTION=
WB_FORM_PRIVACY_REMOVAL=

# 정정 폼에 엔터티 id와 출처 URL을 미리 채우기 위한 Google Forms 필드 이름.
# Google Forms에서 "사전 입력된 링크 가져오기"로 확인할 수 있습니다.
# 예: entry.123456789
WB_FORM_FIELD_ENTITY_ID=
WB_FORM_FIELD_SOURCE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# 2. 자동화(GitHub Actions)에서만 쓰는 값
#
# 앱에는 들어가지 않습니다. GitHub → Settings → Secrets and variables 에 넣으세요.
#   Secrets  = 값이 비밀인 것 (아래 *_KEY, *_SECRET)
#   Variables = 비밀이 아닌 설정 (아래 WB_INGEST_*, WB_*_IDS)
# ─────────────────────────────────────────────────────────────────────────────

# 네이버 뉴스 검색 API — https://developers.naver.com/apps
# 제목·언론사·발행시각·API 제공 설명·원문 URL만 저장합니다. 본문은 저장하지 않습니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
# 공식 채널의 영상 메타데이터와 링크만 저장합니다.
YOUTUBE_API_KEY=
# 수집 대상 공식 채널 id (쉼표 구분). Variables 로 넣으세요.
WB_YOUTUBE_CHANNEL_IDS=

# 기상청 단기·중기예보 — https://www.data.go.kr (공공데이터포털 활용 신청)
# 단기 D+0~2, 중기 D+3~10 만 저장합니다. 11일 이후 일별 값은 만들지 않습니다.
KMA_SERVICE_KEY=
# 예보구역 코드 (쉼표 구분). Variables 로 넣으세요.
WB_KMA_ZONES=

# 수집 활성화 플래그. 값이 정확히 "1" 일 때만 그 원천을 수집합니다.
# WBAK/KBSA는 여기에 없습니다 — 변수만으로는 켤 수 없고,
# scripts/ingest/fetch_sources.py 의 blocked_reason 을 코드 리뷰로 제거해야 합니다.
WB_INGEST_NAVER=0
WB_INGEST_YOUTUBE=0
WB_INGEST_KMA=0
WB_INGEST_WBSC=0
WB_INGEST_WPBL=0

# ─────────────────────────────────────────────────────────────────────────────
# 3. 아직 쓰지 않는 값
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Cloud Messaging. 첫 버전은 기기 로컬 알림만 씁니다.
# 클라이언트 수신 구조만 준비돼 있고, 발송 비밀키는 앱에 절대 넣지 않습니다.
# FCM_SERVER_KEY=   ← 앱 저장소에 두지 마세요. 서버에서만 사용합니다.
