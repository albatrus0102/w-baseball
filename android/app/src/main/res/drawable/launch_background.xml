<?xml version="1.0" encoding="utf-8"?>
<!--
  The first frame the user sees. It has to be the app's own canvas colour, not
  white: the app paints #F7F5F0, so a white splash flashes and then darkens on
  every cold start.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
